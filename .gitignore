# .gitignore - PostgreSQL ve sensitive files

# PostgreSQL data
pgdata/
pgdata2/
postgres/
*.wal
pg_wal/

# Environment files
.env
.env.local
.env.production
.env.staging

# Database
*.db
*.sqlite
*.sqlite3

# Redis
redis-data/
dump.rdb

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Node modules
node_modules/

# Build outputs
.next/
dist/
build/